<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" styleClass="calculadora-container" fx:controller="cl.nicolas.prueba1.Controller"
      xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Pantalla de la calculadora -->
    <TextField
            editable="false"
            fx:id="txtPantalla"
            text="0"
            styleClass="pantalla"/>

    <!-- Cuadrícula de botones (GridPane) -->
    <GridPane hgap="10.0" vgap="10.0">
        <!-- Fila 0 -->
        <Button text="C" onAction="#procesarAccion" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="btn-num, btn-clear"/>
        <Button text="+/-" onAction="#procesarAccion" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="btn-num, btn-op"/>
        <Button text="\%" onAction="#procesarOperador" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="btn-num, btn-op"/>
        <Button text="/" onAction="#procesarOperador" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="btn-num, btn-op"/>

        <!-- Fila 1 -->
        <Button text="7" onAction="#procesarNumero" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="btn-num"/>
        <Button text="8" onAction="#procesarNumero" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="btn-num"/>
        <Button text="9" onAction="#procesarNumero" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="btn-num"/>
        <Button text="X" onAction="#procesarOperador" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="btn-num, btn-op"/>

        <!-- Fila 2 -->
        <Button text="4" onAction="#procesarNumero" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="btn-num"/>
        <Button text="5" onAction="#procesarNumero" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="btn-num"/>
        <Button text="6" onAction="#procesarNumero" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="btn-num"/>
        <Button text="-" onAction="#procesarOperador" GridPane.columnIndex="3" GridPane.rowIndex="2" styleClass="btn-num, btn-op"/>

        <!-- Fila 3 -->
        <Button text="1" onAction="#procesarNumero" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="btn-num"/>
        <Button text="2" onAction="#procesarNumero" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="btn-num"/>
        <Button text="3" onAction="#procesarNumero" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="btn-num"/>
        <Button text="+" onAction="#procesarOperador" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="btn-num, btn-op"/>

        <!-- Fila 4 -->
        <!-- El 0 ocupa 2 columnas (GridPane.columnSpan="2") -->
        <Button text="0" onAction="#procesarNumero" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" styleClass="btn-num, btn-cero"/>
        <Button text="." onAction="#procesarNumero" GridPane.columnIndex="2" GridPane.rowIndex="4" styleClass="btn-num"/>
        <Button text="=" onAction="#procesarAccion" GridPane.columnIndex="3" GridPane.rowIndex="4" styleClass="btn-num, btn-igual"/>
    </GridPane>
</VBox>
